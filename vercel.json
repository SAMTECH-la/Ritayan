{
  "version": 2,
  "builds": [
    {
      "src": "public-website/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "admin-panel/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "backend/api/index.php",
      "use": "vercel-php@0.6.0"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/backend/api/index.php"
    },
    {
      "src": "/uploads/(.*)",
      "dest": "/backend/uploads/$1"
    },
    {
      "src": "/admin/(.*)",
      "dest": "/admin-panel/dist/$1"
    },
    {
      "src": "/admin",
      "dest": "/admin-panel/dist/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/public-website/dist/$1"
    }
  ]
}
